# pyenv
#   For a library or package, you might want to ignore these files since the Python version
#   is managed by the developer and not the package.
# .python-version

# pipenv
#   According to pypa/pipenv#1173, it is recommended not to include Pipfile.lock in libraries,
#   but to include it in images/containers/applications.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in applications.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in applications.
# pdm.lock

# PEP 582; used by e.g. github.com/pypa/pdm
__pypackages__/

